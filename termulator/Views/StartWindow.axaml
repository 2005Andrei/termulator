<?xml version="1.0"?>
<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:termulator.ViewModels" x:Class="termulator.Views.StartWindow" x:DataType="vm:StartWindowViewModel" Width="600" Height="500" WindowStartupLocation="CenterScreen" SystemDecorations="None" Icon="/Assets/avalonia-logo.ico" Title="SplashScreen">
    <Panel>
        <Border BorderBrush="Black" BorderThickness="2" IsVisible="{Binding IsIntroVisible}">
            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="30" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="{Binding TextOpacity}">
                <TextBlock.Transitions>
                    <Transitions>
                        <!-- cursed time format -->
                        <DoubleTransition Property="Opacity" Duration="0:0:0.5"/>
                    </Transitions>
                </TextBlock.Transitions>
            </TextBlock>
        </Border>
        <Border BorderBrush="Black" BorderThickness="2" IsVisible="{Binding CheckDocker}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="15">
                <Grid RowDefinitions="Auto, Auto, Auto">
                    <TextBlock Grid.Row="0" FontWeight="Bold" FontSize="16" Text="Docker is a requirment for this learning experience"/>
                    <TextBlock Grid.Row="1" FontSize="14" TextWrapping="Wrap" TextAlignment="Center" Text="Checking for docker on your machine" Margin="0, 0, 0, 5"/>
                    <TextBlock Grid.Row="2" FontSize="14" TextWrapping="Wrap" TextAlignment="Center" Text="The app will spin up a linux image via docker for you." Margin="0, 0, 0, 5"/>
                </Grid>
            </StackPanel>
        </Border>
        <Border BorderBrush="Black" BorderThickness="2" IsVisible="{Binding DockerSuccess}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="15">
                <TextBlock Text="Docker is installed on your system" Foreground="Green" FontWeight="Bold" FontSize="24" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
        <Border BorderBrush="Black" BorderThickness="2" IsVisible="{Binding DockerFail}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="15">
                <TextBlock Text="ERROR: Docker Not Found" Foreground="Red" FontWeight="Bold" FontSize="24" HorizontalAlignment="Center"/>
                <TextBlock Text="You must have Docker installed and running on your system to use Termulator." TextWrapping="Wrap" TextAlignment="Center" MaxWidth="300"/>
            </StackPanel>
        </Border>
        <Border Background="#151515" BorderBrush="#333" BorderThickness="1" CornerRadius="8" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="400" IsVisible="{Binding LoadZip}">
            <StackPanel Spacing="16">
                <TextBlock Text="SYSTEM INITIALIZATION" Foreground="Cyan" FontWeight="Bold" FontSize="14" LetterSpacing="1"/>
                <Rectangle Height="1" Fill="#333" HorizontalAlignment="Stretch" Margin="0,-4,0,4"/>
                <StackPanel Spacing="6">
                    <TextBlock Text="SELECT BOOT MODE" Foreground="#888" FontSize="11" FontWeight="SemiBold"/>
                    <ComboBox HorizontalAlignment="Stretch" SelectedIndex="0" Background="#222" BorderBrush="#444" Foreground="#EEE" CornerRadius="4" Padding="10,8">
                        <ComboBoxItem Content="Load Story"/>
                        <ComboBoxItem Content="Load State"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Spacing="6">
                    <TextBlock Text="TARGET DATA FILE (.ZIP)" Foreground="#888" FontSize="11" FontWeight="SemiBold"/>
                    <Grid ColumnDefinitions="*, Auto">
                        <Border Grid.Column="0" Background="#1A1A1A" BorderBrush="#444" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,8,0">
                            <Grid>
                                <TextBlock Text="Select a zip from your computer..." FontStyle="Italic" Foreground="#555" VerticalAlignment="Center" IsVisible="{Binding !HasFile}"/>
                                <TextBlock Text="{Binding FilePath}" Foreground="#EEE" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FilePath}" IsVisible="{Binding HasFile}"/>
                            </Grid>
                        </Border>
                        <Button Grid.Column="1" Content="BROWSE..." Click="fileBtn" Background="#333" Foreground="#EEE" BorderThickness="1" BorderBrush="#555" CornerRadius="4" Padding="15,8" Cursor="Hand"/>
                    </Grid>
                </StackPanel>
                <Button Content="START SEQUENCE" Click="submitBtn" IsEnabled="{Binding HasFile}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#004D40" Foreground="Lime" BorderBrush="Lime" BorderThickness="1" CornerRadius="4" Padding="0,12" Margin="0,8,0,0" FontWeight="Bold" LetterSpacing="1" Cursor="Hand"/>
            </StackPanel>
        </Border>
    </Panel>
</Window>
